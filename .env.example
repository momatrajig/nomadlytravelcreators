# Copy to .env.local. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# eBooking Center (DCS Plus IRIX). EBC_MODE=mock serves fixtures for local development.
EBC_MODE=mock
EBC_BASE_URL=https://www.ebookingcenter.com/tbs/reseller
EBC_CLIENT_ID=
EBC_CLIENT_SECRET=
EBC_SCOPES=read:hotels-search write:hotels-book read:mapping read:reservations write:reservations read:reservations-documents read:resellerCredit
EBC_LEADER_NATIONALITY_ID=
EBC_SELLING_CHANNEL=B2C

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Platform
PLATFORM_HOST=nomadly.app
NOMADLY_MARKUP=0.07
CREATOR_SHARE_MAX=0.08
